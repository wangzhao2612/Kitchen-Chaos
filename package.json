{
  "name": "kitchen-chaos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "play": "npm run build && node scripts/start-preview.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean:test": "node scripts/clean-test-output.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
